NODE_ENV=production
PORT=5555

# opencode zen (OpenAI-compatible gateway). Isi di .env lokal / env server,
# jangan pernah di-commit dan jangan pernah dikirim ke frontend.
OPENCODE_API_KEY=your_opencode_zen_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=gemini-3.7-flash
OPENCODE_MAX_TOKENS=1024

# Proteksi biaya: origin yang boleh memanggil API (pisah dengan koma),
# jumlah request per jendela waktu, dan panjang maksimal pertanyaan.
ALLOWED_ORIGINS=https://portfolio.yum-dev.com,https://yumnadev.documentme.my.id
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
MAX_PROMPT_LENGTH=1000

# Jumlah proxy di depan aplikasi (Nginx = 1). Salah isi = rate limit tidak akurat.
TRUST_PROXY_HOPS=1
